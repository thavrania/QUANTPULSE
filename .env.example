# =====================================================================
# QUANTPULSE — Environment Variables Configuration
# =====================================================================

# Optional: Supabase Free PostgreSQL & Realtime Configuration
# If left empty, QuantPulse operates smoothly in high-fidelity standalone demo mode!
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Telegram Alerts Bot Configuration (Optional: Instant webhook push alerts)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-or-group-id-here
