# =====================================================================
# QUANTPULSE — Environment Variables Configuration
# =====================================================================

# Optional: Supabase PostgreSQL & Realtime Configuration
# If left empty, QuantPulse operates in high-fidelity standalone demo mode!
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Telegram Alerts Bot Configuration (Instant webhook push alerts)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-or-group-id-here

# =====================================================================
# Dhan HQ API Server-Side Automated Authentication
# Hierarchy: API Key + API Secret + TOTP Secret -> Fresh Access Token
# Server-Side Only: Never exposed to frontend or client browser.
# =====================================================================
# 1. Dhan 10-Digit Client ID (e.g. 1000000001)
DHAN_CLIENT_ID=your-dhan-client-id

# 2. Dhan Developer API Key (App ID) generated under "Access DhanHQ APIs" -> "API Key" mode
DHAN_API_KEY=your-dhan-api-key

# 3. Dhan API Secret paired with the API Key
DHAN_API_SECRET=your-dhan-api-secret

# 4. Dhan TOTP Base32 Secret Key (from Dhan Web -> Access DhanHQ APIs -> Optional Settings -> Set-up TOTP)
DHAN_TOTP_SECRET=your-dhan-base32-totp-secret

# 5. Optional Legacy Static Access Token (fallback if automated credentials are not yet configured)
DHAN_ACCESS_TOKEN=
